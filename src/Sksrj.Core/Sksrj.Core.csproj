<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Sksrj.Core</RootNamespace>
    <Product>SKSRJ Timetable generator</Product>
    <Authors>Oskar Jagodziński</Authors>
    <Copyright>Copyright © 2026 Oskar Jagodziński. GNU GPL v3 lub nowsza z warunkami dodatkowymi (ADDITIONAL_TERMS).</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Sksrj.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
