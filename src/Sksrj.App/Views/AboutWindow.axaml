<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="Sksrj.App.Views.AboutWindow"
        Width="760" Height="680" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Md.SurfaceContainerLow}"
        Title="O programie – SKSRJ Timetable generator"
        Icon="avares://SKSRJ/Assets/sksrj.png">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="Auto,*">
      <Image Source="avares://SKSRJ/Assets/sksrj.png" Width="72" Height="72" VerticalAlignment="Top" Margin="0,0,18,0" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock x:Name="NameText" Classes="headline" />
        <TextBlock x:Name="TaglineText" Classes="body-small" />
        <TextBlock x:Name="CopyrightText" FontWeight="SemiBold" Margin="0,8,0,0" />
        <TextBlock x:Name="AttributionText" TextWrapping="Wrap" FontSize="13" />
        <TextBlock x:Name="LicenseText" TextWrapping="Wrap" FontSize="13" Classes="muted" />
        <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="12" Classes="muted" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>
    <TabControl Grid.Row="1" Margin="0,16,0,0">
      <TabItem Header="Licencja (GPL v3)">
        <TextBox x:Name="LicenseBox" Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" VerticalContentAlignment="Top" />
      </TabItem>
      <TabItem Header="Warunki dodatkowe">
        <TextBox x:Name="TermsBox" Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" VerticalContentAlignment="Top" />
      </TabItem>
      <TabItem Header="Komponenty zewnętrzne">
        <TextBox x:Name="NoticesBox" Classes="mono" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" VerticalContentAlignment="Top" />
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="SourceButton" Classes="outlined" Click="OnSource">
        <StackPanel Orientation="Horizontal" Spacing="8"><mi:MaterialIcon Kind="Github" /><TextBlock Text="Kod źródłowy" /></StackPanel>
      </Button>
      <Button Classes="filled" Content="Zamknij" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
